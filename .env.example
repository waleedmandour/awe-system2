# AWE System Environment Variables
# Copy this file to .env and fill in your values

# Database URL (SQLite for local development)
DATABASE_URL="file:./db/custom.db"

# ── Authentication ─────────────────────────────────────────────────────────────
# Secret key for HMAC token signing (required for auth middleware)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# ── Authentication Modes (choose one) ─────────────────────────────────────────
#
# Mode 1: VERTEX AI + ADC (recommended for production determinism)
#   Full Vertex AI with Application Default Credentials (ADC).
#   Provides: region selection, seed/topK/topP determinism, Section 18 privacy.
#   For Vercel: set GOOGLE_APPLICATION_CREDENTIALS_JSON to the service account JSON.
#   For local dev: run `gcloud auth application-default login`.
# GOOGLE_CLOUD_PROJECT=gen-lang-client-0306752577
# GOOGLE_CLOUD_LOCATION=me-central1
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Mode 2: VERTEX AI EXPRESS (quick start — API key only)
#   Uses an Agent Platform API key. The SDK routes to the global Vertex AI
#   endpoint automatically. No project or location needed.
#   Provides: Section 18 privacy. Limited determinism (no region control).
#   NOTE: project/location and apiKey are MUTUALLY EXCLUSIVE in the SDK.
# VERTEX_API_KEY=AQ.your-api-key-here

# Mode 3: AI STUDIO (legacy fallback)
#   Free Gemini API — no privacy guarantee, no determinism controls.
# ⚠️ WARNING: The free Gemini API may use your data for model training.
# GEMINI_API_KEY=your-gemini-api-key

# ── Optional ──────────────────────────────────────────────────────────────────
# (No optional variables currently needed)
