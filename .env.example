# AWE System Environment Variables
# Copy this file to .env and fill in your values

# Database URL (SQLite for local development)
DATABASE_URL="file:./db/custom.db"

# ── Authentication ─────────────────────────────────────────────────────────────
# Secret key for HMAC token signing (required for auth middleware)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# ── Authentication Modes (choose one) ─────────────────────────────────────────
#
# Mode 1: VERTEX AI + ADC (recommended for production determinism)
#   Full Vertex AI with Application Default Credentials (ADC).
#   Provides: region selection, seed/topK/topP determinism, Section 18 privacy.
#   For Vercel: set GOOGLE_APPLICATION_CREDENTIALS_JSON to the service account JSON.
#   For local dev: run `gcloud auth application-default login`.
# GOOGLE_CLOUD_PROJECT=gen-lang-client-0306752577
# GOOGLE_CLOUD_LOCATION=me-central1
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Mode 2: VERTEX AI EXPRESS (quick start — API key only)
#   Uses an Agent Platform API key. The SDK routes to the global Vertex AI
#   endpoint automatically. No project or location needed.
#   Provides: Section 18 privacy. Limited determinism (no region control).
#   NOTE: project/location and apiKey are MUTUALLY EXCLUSIVE in the SDK.
# VERTEX_API_KEY=AQ.your-api-key-here

# Mode 3: AI STUDIO (legacy fallback)
#   Free Gemini API — no privacy guarantee, no determinism controls.
# ⚠️ WARNING: The free Gemini API may use your data for model training.
# GEMINI_API_KEY=your-gemini-api-key

# ── LTI 1.3 Integration (Moodle) ───────────────────────────────────────────────
# Required for Moodle LTI 1.3 + AGS grade passback integration.
# Run `node scripts/generate-lti-keys.js` to generate the RSA key pair.
#
# Platform issuer URL (Moodle base URL)
# LTI_ISSUER=https://elearnt.squ.edu.om
#
# OAuth2 client ID (provided by Moodle admin when registering the tool)
# LTI_CLIENT_ID=your-client-id
#
# Platform OIDC authorization endpoint
# LTI_AUTH_ENDPOINT=https://elearnt.squ.edu.om/mod/lti/auth.php
#
# Platform OAuth2 token endpoint (for AGS grade passback)
# LTI_TOKEN_ENDPOINT=https://elearnt.squ.edu.om/mod/lti/token.php
#
# Platform JWKS endpoint (for verifying id_tokens from Moodle)
# LTI_JWKS_ENDPOINT=https://elearnt.squ.edu.om/mod/lti/certs.php
#
# Deployment ID (optional, defaults to "1")
# LTI_DEPLOYMENT_ID=1
#
# RSA private key in PEM format for signing JWTs
# Generate with: node scripts/generate-lti-keys.js
# LTI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#
# Key ID for JWKS kid claim (optional, defaults to "awe-lti-key-1")
# LTI_KEY_ID=awe-lti-key-1
#
# Base URL of the deployed AWE tool (for constructing redirect URIs)
# Required in production. Defaults to http://localhost:3000 in development.
# LTI_TOOL_URL=https://your-awe-app.vercel.app

# ── Optional ──────────────────────────────────────────────────────────────────
# (No optional variables currently needed)
